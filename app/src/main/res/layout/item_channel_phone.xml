<?xml version="1.0" encoding="utf-8"?>
<!--
    手机端频道行（布局方案 B：列表优先）。
    设计图一行只有「台标方块 / 频道名 / 当前节目 / 收藏星标」：
    台标方块本身就是编号（CCTV1→1），不再额外叠一个红色编号块。
    ID 与 item_channel.xml 保持一致，ChannelAdapter 共用同一套绑定逻辑。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/card_height"
    android:layout_margin="@dimen/card_margin"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_channel_card"
    android:stateListAnimator="@animator/focus_scale"
    android:clipChildren="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- 台标方块：本地绘制图已按频道名写上 1/2/湖南/凤凰，直接作为设计图里的彩色块 -->
        <FrameLayout
            android:layout_width="@dimen/card_logo_size"
            android:layout_height="@dimen/card_logo_size"
            android:background="@drawable/bg_logo_placeholder">

            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:padding="2dp"
                android:contentDescription="台标" />
        </FrameLayout>

        <!-- 频道名 + 当前正在播放的节目（来自 EPG 缓存，没缓存时回退到分组名） -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:minWidth="0dp">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="CCTV1"
                android:textSize="@dimen/card_name"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="@dimen/card_name_min"
                app:autoSizeMaxTextSize="@dimen/card_name"
                app:autoSizeStepGranularity="1sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="新闻30分 · 12:00"
                    android:textSize="@dimen/card_meta"
                    android:textColor="@color/text_secondary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_live"
                    android:text="@string/live_badge"
                    android:textSize="@dimen/card_badge"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 收藏星标：设计图是细线小星，不再抢频道名位置 -->
        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:padding="2dp"
            android:src="@drawable/ic_star_off"
            android:contentDescription="@string/favorite_add"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- 编号仍由适配器写入，供搜索「编号」功能使用；设计图上由台标方块显示，故隐藏 -->
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text="1"
        android:visibility="gone" />
</FrameLayout>
