<?xml version="1.0" encoding="utf-8"?>
<!--
    手动换源浮层：列出一个频道下的全部线路，由用户自己挑。
    与「换线」按钮的区别：那个只能顺序切下一条，遇到「前几条都能播但不理想」时
    根本绕不过去；这里直接给全量列表，点哪条走哪条。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_glass"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/tvSourcePickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="选择线路"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/section_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSourcePickerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="当前线路卡顿或没声音时，可直接选另一条线路"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

    <ScrollView
        android:id="@+id/svSourceList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llSourceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
