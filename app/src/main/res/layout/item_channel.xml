<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 大屏频道卡（设计图：大屏直播频道布局）
    横向排版：左侧彩色台标方块 + 右侧频道名 / 当前节目，单屏 5×4。
    焦点态描边由 bg_channel_card 给出（3dp 白框），配合 focus_scale 放大到 1.10。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="@dimen/card_height"
    android:layout_margin="@dimen/card_margin"
    android:background="@drawable/bg_channel_card"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true"
    android:stateListAnimator="@animator/focus_scale">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <!-- 台标方块：本地绘制图兜底，网络台标异步覆盖 -->
        <FrameLayout
            android:layout_width="@dimen/card_logo_size"
            android:layout_height="@dimen/card_logo_size"
            android:background="@drawable/bg_logo_placeholder">

            <TextView
                android:id="@+id/tvLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="C"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="台标"
                android:padding="2dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- 频道名 + 当前节目 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="CCTV1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/card_name"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="@dimen/card_name"
                app:autoSizeMinTextSize="@dimen/card_name_min"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <TextView
                android:id="@+id/tvGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="新闻联播 · 19:00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/card_meta" />
        </LinearLayout>

        <!-- 收藏星标：按用户要求保留，但缩小到 20dp，不抢频道名位置 -->
        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:contentDescription="@string/favorite_add"
            android:focusable="true"
            android:padding="1dp"
            android:src="@drawable/ic_star_off_shape" />
    </LinearLayout>

    <!-- 序号与直播标识：TV 设计图卡片不展示，保留 ID 供适配器共用绑定逻辑 -->
    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text="1"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvScore"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:text="直播"
        android:visibility="gone" />
</FrameLayout>
