<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- ============ 频道列表页 ============ -->
    <LinearLayout
        android:id="@+id/pageList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingTop="@dimen/page_padding_top">

        <!--
            顶部标签导航：当前页 + 三个入口。
            三个入口的 id 和点击逻辑都不变，只是从右上角按钮改成标签形态。
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|start"
            android:layout_marginTop="@dimen/tabs_margin_top"
            android:layout_marginBottom="@dimen/header_gap">

            <!-- 当前页标签：与右侧三个按钮同一套尺寸，普通 TextView 保证不可点 -->
            <TextView
                android:layout_width="@dimen/tab_width"
                android:layout_height="@dimen/tab_height"
                android:gravity="center"
                android:background="@drawable/bg_tab_selected"
                android:text="@string/channel_list_title"
                android:textSize="@dimen/top_button_text"
                android:textStyle="bold"
                android:textColor="#FFFFFFFF"
                android:focusable="false"
                android:clickable="false" />

            <Button
                android:id="@+id/btnConfig"
                style="@style/TabButton"
                android:layout_width="@dimen/tab_width"
                android:layout_height="@dimen/tab_height"
                android:layout_marginStart="@dimen/tab_gap"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_config"
                android:textSize="@dimen/top_button_text" />

            <Button
                android:id="@+id/btnSettings"
                style="@style/TabButton"
                android:layout_width="@dimen/tab_width"
                android:layout_height="@dimen/tab_height"
                android:layout_marginStart="@dimen/tab_gap"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/settings"
                android:textSize="@dimen/top_button_text" />

            <Button
                android:id="@+id/btnAbout"
                style="@style/TabButton"
                android:layout_width="@dimen/tab_width"
                android:layout_height="@dimen/tab_height"
                android:layout_marginStart="@dimen/tab_gap"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/about_entry"
                android:textSize="@dimen/top_button_text" />
        </LinearLayout>

        <!-- 焦点频道卡片：白卡 + 发丝描边 -->
        <FrameLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_height"
            android:background="@drawable/bg_hero_gradient"
            android:focusable="true"
            android:clickable="true"
            android:stateListAnimator="@animator/focus_scale"
            android:layout_marginBottom="@dimen/hero_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <FrameLayout
                    android:layout_width="@dimen/hero_logo"
                    android:layout_height="@dimen/hero_logo"
                    android:background="@drawable/bg_logo_placeholder"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:id="@+id/ivHeroLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="8dp"
                        android:contentDescription="台标" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <!-- 频道名 + 「正在直播」标签同一行：标签跟在名称后面。
                         名称用 weight 占满剩余宽度并省略号截断，标签 wrap_content 固定在右侧，
                         长频道名也不会把标签挤出屏幕（手机上同理）。 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvHeroTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:text="@string/hero_hint"
                            android:textSize="@dimen/hero_title"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvHeroBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/hero_badge_gap"
                            android:background="@drawable/bg_badge_live"
                            android:paddingStart="@dimen/hero_badge_pad_h"
                            android:paddingEnd="@dimen/hero_badge_pad_h"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:text="@string/hero_badge"
                            android:textSize="@dimen/hero_badge_text"
                            android:textColor="@color/text_secondary"
                            android:maxLines="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hero_sub_gap"
                        android:text="@string/hero_playing"
                        android:textSize="@dimen/hero_sub"
                        android:textColor="@color/text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- 焦点频道的实时节目单：标题随频道/滚动变化 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="@dimen/hero_epg_gap">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@android:drawable/ic_media_play"
                            android:tint="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvHeroEpg"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:layout_marginStart="6dp"
                            android:text="@string/hero_playing"
                            android:textSize="@dimen/hero_sub"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvHeroEpgNext"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/hero_next_gap"
                        android:text=""
                        android:textSize="@dimen/epg_next_text"
                        android:textColor="@color/text_secondary"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- 焦点频道与频道列表之间的分隔线，让两个区块层次更清楚 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="4dp" />

        <!-- 分区标题 + 次级入口 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/section_gap">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/channel_list_title"
                android:textSize="@dimen/section_title"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvChannelCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text=""
                android:textSize="@dimen/card_meta"
                android:textColor="@color/text_hint" />

        <!-- 三个入口已移到顶部标签行，这里只留分区标题和频道数 -->
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/groupScroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="@dimen/chips_gap">

            <LinearLayout
                android:id="@+id/groupContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 频道网格 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/empty_hint"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- ============ 播放器页 ============ -->
    <FrameLayout
        android:id="@+id/pagePlayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone">

        <!-- 播放视图容器：SurfaceView / TextureView 两种渲染方式在运行时二选一，
             避免把 PlayerView 写死在这里，无法切换渲染方式与自定义缩放 -->
        <FrameLayout
            android:id="@+id/videoHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="true"
            android:clipToPadding="true" />

        <ProgressBar
            android:id="@+id/pbLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- 顶部信息条：播放开始几秒后自动淡出，避免按钮和状态字长期压住画面；
             按任意键 / 触摸一下即重新出现（见 MainActivity.showOverlay） -->
        <LinearLayout
            android:id="@+id/topPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_top_scrim"
            android:padding="20dp">

            <LinearLayout
                android:id="@+id/btnRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnBack"
                    style="@style/GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="@string/back" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvPlayerTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text=""
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <Button
                    android:id="@+id/btnSwitchLine"
                    style="@style/GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="10dp"
                    android:text="换源"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnFullscreen"
                    style="@style/GhostButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="40dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/fullscreen"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statsBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_dot_green"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_placeholder"
                    android:textSize="@dimen/stats_text"
                    android:textColor="@color/green" />
            </LinearLayout>

        </LinearLayout>

        <!-- 节目单浮层：放在画面左下角，独立于顶部按钮栏，避免把整块画面压暗 -->
        <LinearLayout
            android:id="@+id/epgPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_epg_panel"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvEpgTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/primary"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvEpgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxWidth="420dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvEpgNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxWidth="420dp"
                android:text=""
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
