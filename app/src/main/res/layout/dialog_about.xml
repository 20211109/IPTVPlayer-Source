<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- 顶部装饰条 -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_brand_button"
            android:layout_marginBottom="18dp" />

        <!-- 应用图标 -->
        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- 应用名称 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- 版本号 -->
        <TextView
            android:id="@+id/tvVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/primary" />

        <!-- 检查更新按钮 -->
        <Button
            android:id="@+id/btnCheckUpdate"
            style="@style/GhostButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="42dp"
            android:text="@string/about_check_update" />

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/text_hint"
            android:gravity="center" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- 应用简介 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_intro"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary" />

        <!-- 免责声明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/about_disclaimer"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_hint" />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp" />

        <!-- 开发者二维码标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_contact_title"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="@string/about_contact_hint"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="@color/text_secondary" />

        <!-- 二维码卡片：白色圆角底 + 自适应缩放，保证清晰不变形 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_qr_card"
            android:padding="14dp">

            <ImageView
                android:id="@+id/ivDevQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/dev_wechat_qr"
                android:contentDescription="@string/about_contact_title" />
        </FrameLayout>

        <Button
            android:id="@+id/btnAboutClose"
            style="@style/BrandButton"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="44dp"
            android:text="@string/close" />
    </LinearLayout>
</ScrollView>
