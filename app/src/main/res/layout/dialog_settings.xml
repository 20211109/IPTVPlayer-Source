<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="卡顿与切源"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <!-- 卡顿统计窗口 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="卡顿统计窗口(秒)" />
            <EditText android:id="@+id/etStallWindow" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 卡顿次数阈值 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="窗口内卡顿几次后切源" />
            <EditText android:id="@+id/etStallCount" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 切源冷却 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="切源冷却(秒)" />
            <EditText android:id="@+id/etCooldown" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 连续失败重试上限 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="连续失败重试上限" />
            <EditText android:id="@+id/etMaxRetry" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="缓冲(弱网卡顿主要调这里)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <!-- 最小缓冲 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="最小缓冲(秒)" />
            <EditText android:id="@+id/etBufferMin" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 最大缓冲 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="最大缓冲(秒)" />
            <EditText android:id="@+id/etBufferMax" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 起播缓冲 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="起播缓冲(毫秒)" />
            <EditText android:id="@+id/etPlayStart" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 卡顿后恢复缓冲 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="卡顿后缓冲(毫秒)" />
            <EditText android:id="@+id/etRebuffer" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbShowStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/brand_cyan"
            android:text="显示调试信息(缓冲/丢帧)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="画面与解码"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <!-- 画面比例 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="画面比例" />
            <Spinner
                android:id="@+id/spZoomMode"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:entries="@array/zoom_mode_labels" />
        </LinearLayout>

        <!-- 自定义缩放百分比 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="自定义缩放(50-200%)" />
            <EditText android:id="@+id/etZoomScale" style="@style/SettingInput" android:inputType="number" />
        </LinearLayout>

        <!-- 解码器优先策略 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="解码器优先" />
            <Spinner
                android:id="@+id/spDecoder"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:entries="@array/decoder_labels" />
        </LinearLayout>

        <!-- 渲染方式 -->
        <LinearLayout style="@style/SettingRow">
            <TextView style="@style/SettingLabel" android:text="渲染方式" />
            <Spinner
                android:id="@+id/spRender"
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:entries="@array/render_labels" />
        </LinearLayout>

        <!-- 音频开关（仅视频） -->
        <CheckBox
            android:id="@+id/cbAudio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="@color/brand_cyan"
            android:text="输出声音（关闭=仅视频）"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbAudioCompat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="@color/brand_cyan"
            android:text="AC-3 / MP2 自动软解（推荐）"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="直播源里常有 AC-3 / E-AC-3 / MP2 音轨：盒子即使带解码器也常常只支持直通，表现为有画面没声音且不报错。开启后识别到这类编码会自动切到软解内核（音频 FFmpeg 解码），几秒内出声；设备本身能正常解 AC-3 的可关闭。切换开关后重新进入频道生效。"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <CheckBox
            android:id="@+id/cbAutoSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:buttonTint="@color/brand_cyan"
            android:text="持续卡顿自动换线路（推荐开启）"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="起播连不上（20 秒无画面）会自动换线路；已出画面后，持续缓冲 8 秒或反复卡顿也会换到下一条线路。换线带冷却与熔断，不会两条线路来回跳。关掉后只做原线路重连，不换线。"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <CheckBox
            android:id="@+id/cbInsecureTls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:buttonTint="@color/brand_cyan"
            android:text="忽略证书校验（自签名直播源）"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="很多自建电视/酒店直播系统用私有证书，系统默认会拒绝连接、表现为一直黑屏。勾选后可播放这类源；代价是不再校验服务器身份，仅在放直播时使用。"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="提示：弱网卡顿时优先把「最大缓冲」调到 20–30 秒。状态栏会如实显示「播放中 / 缓冲中 / 原线路重连」，出错时还会显示错误码，反馈问题请截图。参数在下次进入频道时生效。"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
