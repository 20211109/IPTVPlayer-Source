<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_source_item"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp">

    <CheckBox
        android:id="@+id/cbEnabled"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:buttonTint="@color/primary"
        android:contentDescription="@string/source_enable" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSourceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="我的直播源"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSourceDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/btnRename"
        style="@style/GhostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:minHeight="34dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/source_rename"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btnDelete"
        style="@style/GhostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:minWidth="0dp"
        android:minHeight="34dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/source_delete"
        android:textColor="@color/red"
        android:textSize="11sp" />
</LinearLayout>
