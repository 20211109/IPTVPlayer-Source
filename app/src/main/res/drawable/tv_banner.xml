<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV 桌面横幅（leanback banner，建议 320x180）。没有它部分电视不会显示应用入口 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#08090B"
                android:centerColor="#15181E"
                android:endColor="#0A2A52" />
        </shape>
    </item>
    <item
        android:drawable="@mipmap/ic_launcher"
        android:gravity="center" />
</layer-list>
