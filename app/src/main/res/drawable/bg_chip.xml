<?xml version="1.0" encoding="utf-8"?>
<!-- 分组标签：选中浅灰底 + 蓝描边，聚焦白底 + 蓝描边，保持深灰文字始终清晰 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0E9DA" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF8" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF8" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FFE4DED0" />
        </shape>
    </item>
</selector>
