<?xml version="1.0" encoding="utf-8"?>
<!--
    分类胶囊（全部 / 央视 / 卫视 …）：焦点与选中必须一眼分开。
    焦点 = 白色光晕 + 3dp 纯白边；选中 = 深灰底 + 1.5dp 淡白边。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF3A3A3C" />
                    <corners android:radius="22dp" />
                    <stroke android:color="#FFFFFFFF" android:width="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="22dp" />
            <stroke android:color="#66FFFFFF" android:width="1.5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="22dp" />
            <stroke android:color="#1FD1D1D6" android:width="1dp" />
        </shape>
    </item>
</selector>
