<?xml version="1.0" encoding="utf-8"?>
<!-- 分组标签：tvOS 的分段控件观感 —— 选中/聚焦靠提亮和白色描边，不用蓝色填充 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
</selector>
