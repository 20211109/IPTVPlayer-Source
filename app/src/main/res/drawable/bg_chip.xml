<?xml version="1.0" encoding="utf-8"?>
<!--
    分组胶囊：设计图选中项白底深字，未选中深灰底灰字，
    焦点 3px 白描边（TV 上必须一眼看到当前焦点）。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点优先：白底会导致主文字看不见，改为深底白框 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#1FD1D1D6" />
        </shape>
    </item>
</selector>
