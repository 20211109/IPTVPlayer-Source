<?xml version="1.0" encoding="utf-8"?>
<!-- 线路列表单行背景：遥控器焦点必须一眼可见，所以焦点态用「提亮底 + 蓝色描边」 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF525D6E" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF0A84FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF46505F" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF4DA3FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF414A59" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
