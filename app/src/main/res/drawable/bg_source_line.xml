<?xml version="1.0" encoding="utf-8"?>
<!-- 线路列表：焦点用提亮 + 白描边，和其它 tvOS 卡片保持一致 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF48484A" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
</selector>
