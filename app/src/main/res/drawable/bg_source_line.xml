<?xml version="1.0" encoding="utf-8"?>
<!-- 线路列表：白底卡片，焦点浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE8EEF7" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFDCE4F0" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#142C3440" />
        </shape>
    </item>
</selector>
