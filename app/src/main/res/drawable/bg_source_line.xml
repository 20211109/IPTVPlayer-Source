<?xml version="1.0" encoding="utf-8"?>
<!-- 线路列表：白底卡片，焦点浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="14dp" />
            <stroke android:width="1.5dp" android:color="#FFE84643" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#FFE84643" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#26D1D1D6" />
        </shape>
    </item>
</selector>
