<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点频道大卡：白卡 + 发丝描边，聚焦时浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFE8EEF7"
                android:centerColor="#FFEFF3FA" android:endColor="#FFDCE4F0" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#EBFFFFFF"
                android:centerColor="#EBFFFFFF" android:endColor="#EBF6F9FD" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#142C3440" />
        </shape>
    </item>
</selector>
