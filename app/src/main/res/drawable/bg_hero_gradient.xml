<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点频道大卡：白卡 + 发丝描边，聚焦时浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFF0E9DA"
                android:centerColor="#FFF5F0E4" android:endColor="#FFE4DED0" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFFDF8"
                android:centerColor="#FFFFFDF8" android:endColor="#FFF8F4EA" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#143A3528" />
        </shape>
    </item>
</selector>
