<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点频道大卡：白卡 + 发丝描边，聚焦时浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFE5E5EA"
                android:centerColor="#FFECECF0" android:endColor="#FFD8D8DD" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FFFFFFFF"
                android:centerColor="#FFFFFFFF" android:endColor="#FFF7F7F9" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#14000000" />
        </shape>
    </item>
</selector>
