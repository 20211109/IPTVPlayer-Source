<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点频道大卡：白卡 + 发丝描边，聚焦时浅灰底 + 蓝描边 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF2C2C2E"
                android:centerColor="#FF222224" android:endColor="#FF3A3A3C" />
            <corners android:radius="22dp" />
            <stroke android:width="1.5dp" android:color="#FFE84643" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1C1C1E"
                android:centerColor="#FF1C1C1E" android:endColor="#FF1C1C1E" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#26D1D1D6" />
        </shape>
    </item>
</selector>
