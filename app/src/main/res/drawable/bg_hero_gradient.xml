<?xml version="1.0" encoding="utf-8"?>
<!-- 焦点频道大卡：tvOS 的「继续观看」卡是深灰玻璃 + 顶部一道反光，选中时白边抬起 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#FF3A3A3C"
                        android:centerColor="#FF303032" android:endColor="#FF242426" />
                    <corners android:radius="22dp" />
                    <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#FF242426"
                        android:centerColor="#FF1E1E20" android:endColor="#FF151517" />
                    <corners android:radius="22dp" />
                    <stroke android:width="1dp" android:color="#14FFFFFF" />
                </shape>
            </item>
            <!-- 玻璃表面那层很淡的顶部高光 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#0AFFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="22dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
