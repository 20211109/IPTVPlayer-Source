<?xml version="1.0" encoding="utf-8"?>
<!--
    设置里的「数值格」：白底胶囊 + 蓝色数字，
    焦点时浅灰底 + 蓝描边，告诉用户「按确定可以改」。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <stroke android:width="1.5dp" android:color="#FFE84643" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <stroke android:width="1dp" android:color="#FFE84643" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <stroke android:width="1dp" android:color="#FF3A3A3C" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
