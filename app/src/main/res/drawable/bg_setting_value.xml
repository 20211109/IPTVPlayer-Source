<?xml version="1.0" encoding="utf-8"?>
<!--
    设置弹窗里的「数值格」：平时是深色药丸 + 发丝描边，
    焦点（遥控器选中）时换成蓝色描边 + 蓝色数字，明确告诉用户「这里按确定可以改」。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="2dp" android:color="@color/brand_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <stroke android:width="1dp" android:color="@color/brand_cyan" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
