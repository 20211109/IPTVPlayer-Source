<?xml version="1.0" encoding="utf-8"?>
<!--
    设置里的「数值格」：平时是深灰胶囊 + 蓝色数字，
    焦点时换成白描边 + 提亮底，告诉用户「按确定可以改」。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF48484A" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
