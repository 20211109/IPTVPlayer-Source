<?xml version="1.0" encoding="utf-8"?>
<!--
    设置弹窗 Spinner / 「我的」页整行入口的焦点框。

    电视上「光标在哪」必须一眼看到：聚焦时外圈一层半透明白光晕，
    内圈 3dp 纯白描边 + 深灰底；未聚焦时完全透明（不占视觉重量）。
    选中态（isSelected）和聚焦态是两回事，这里只认 focused，
    避免侧边栏「当前页」和「遥控器光标」都亮白框、用户分不清。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <!-- 外发光 -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#59FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <!-- 主体：内缩 2dp，白描边 3dp -->
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF2C2C2E" />
                    <corners android:radius="10dp" />
                    <stroke android:color="#FFFFFFFF" android:width="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="10dp" />
            <stroke android:color="@android:color/transparent" android:width="3dp" />
        </shape>
    </item>
</selector>
