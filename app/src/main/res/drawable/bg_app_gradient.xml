<?xml version="1.0" encoding="utf-8"?>
<!--
    冷灰底：中间提亮一档，白卡压在上面层次刚好。

    中心色刻意停在 #F7F9FC 而不是纯白：卡片本身就是 #FFFFFF，
    底色一旦也是纯白，屏幕中间那几行卡片就只剩 8% 的描边，等于消失了。
    留这 3% 的明度差，整页才「看得见卡片、又不像深色底那么闷」。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFF2F4F7"
        android:centerColor="#FFF7F9FC"
        android:endColor="#FFF2F4F7"
        android:type="linear" />
</shape>
