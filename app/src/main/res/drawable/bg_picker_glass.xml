<?xml version="1.0" encoding="utf-8"?>
<!--
    频道选择浮层的「磨砂玻璃」面板。
    真实背景模糊由 ChannelPickerDialog 在 Android 12+ 上叠加系统模糊实现；
    低版本没有系统模糊，就用这四层叠出毛玻璃观感：
      1) 半透明深色底——透出后面的播放画面，而不是一块死黑的板子；
      2) 左上→右下的白色微渐变——玻璃表面的高光反射；
      3) 1dp 高光描边——玻璃边缘的厚度感；
      4) 大圆角——不再是硬邦邦的方框。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1) 半透明底 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#DE39414E" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 2) 玻璃高光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- 3) 高光描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#38FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
