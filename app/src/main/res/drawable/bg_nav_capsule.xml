<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 左侧导航胶囊：四项永远同尺寸、同圆角。

    关键：选中态（当前页）与焦点态（遥控器光标）必须明显不同 ——
    之前两者都是白边，用户看不出光标停在哪。
    焦点 = 白色光晕 + 3dp 纯白实边；选中 = 深灰底 + 1dp 淡边，不再抢白框。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF3A3A3C" />
                    <corners android:radius="26dp" />
                    <stroke android:color="#FFFFFFFF" android:width="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="26dp" />
            <stroke android:color="#33FFFFFF" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="26dp" />
            <stroke android:color="#26D1D1D6" android:width="1dp" />
        </shape>
    </item>
</selector>
