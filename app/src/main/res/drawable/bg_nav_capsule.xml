<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 左侧导航胶囊：四项永远同尺寸、同圆角、同描边。
    默认淡底+淡描边（能看出是胶囊），选中略亮，
    焦点 3px 白描边 + 白字，遥控器一眼定位。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#59F5F5F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#26D1D1D6" />
        </shape>
    </item>
</selector>
