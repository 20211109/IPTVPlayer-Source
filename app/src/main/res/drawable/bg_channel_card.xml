<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 焦点态：石墨底 + 单一蓝色描边，TV 遥控器下依然清晰 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF333A47" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FF0A84FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2C323D" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#FF4DA3FF" />
        </shape>
    </item>
    <!-- 默认态：极细发丝描边，避免卡片边界糊在一起 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF212630" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
