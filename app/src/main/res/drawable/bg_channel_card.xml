<?xml version="1.0" encoding="utf-8"?>
<!--
    浅色频道卡：白卡 + 发丝描边；焦点时浅灰底 + 蓝色描边。
    蓝色只在焦点出现，平时整页只有白、浅灰、深灰三种层次。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFF0E9DA" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE4DED0" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#FF007AFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFDF8" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#143A3528" />
        </shape>
    </item>
</selector>
