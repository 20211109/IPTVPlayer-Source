<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 频道卡焦点：白色光晕 + 3dp 纯白描边（1080p 下足够醒目）。
    平时只有 1dp 极淡描边，焦点出现时与选中/普通态一眼可分。
    卡片本身有 6dp margin，2dp 光晕不会被邻卡裁掉。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:left="2dp" android:right="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF2C2C2E" />
                    <corners android:radius="11dp" />
                    <stroke android:color="#FFFFFFFF" android:width="3dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="11dp" />
            <stroke android:color="#FFFFFFFF" android:width="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="11dp" />
            <stroke android:color="#12D1D1D6" android:width="1dp" />
        </shape>
    </item>
</selector>
