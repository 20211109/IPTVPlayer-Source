<?xml version="1.0" encoding="utf-8"?>
<!--
    TV 设计图焦点规范：3px #F5F5F7 描边（1080p 下 3px ≈ 1.5dp）。
    平时只有 1dp 极淡描边，焦点出现时白框 + 4% 放大（animator），
    遥控器一眼就能看出停在哪一格。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- 焦点只加白描边，底色保持深色，否则白字会融进白底看不见 -->
            <solid android:color="#FF2C2C2E" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="#FFF5F5F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#12D1D1D6" />
        </shape>
    </item>
</selector>
