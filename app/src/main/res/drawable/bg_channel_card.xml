<?xml version="1.0" encoding="utf-8"?>
<!--
    tvOS 频道卡：黑底上是深灰玻璃块，选中时提亮一档 + 一圈白色描边。
    不再用蓝色描边 —— Apple TV 的焦点靠「变亮 + 放大 + 白边」，不靠彩色。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A3A3C" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF48484A" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C1C1E" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#0DFFFFFF" />
        </shape>
    </item>
</selector>
