<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android TV 专用：更大字号、更多列、焦点更明显。
         注意：Android TV 1080p 常见窗口高度只有 540dp，
         旧版的 hero 280dp + 卡片 176dp 会把频道网格挤成一条缝，
         导致「下面的频道看不到、页面翻不动」，因此整体压缩高度。

         目标：540dp 高度下稳定露出三行频道。
         竖向预算 ≈ 12(顶部) + 37(标题) + 118(焦点卡) + 48(分区行) + 44(分组标签) = 259dp
         剩余约 281dp → 三行 (82 + 2*4)margins = 270dp，留有余量吸收字体缩放。 -->
    <dimen name="page_padding">40dp</dimen>
    <dimen name="page_padding_top">12dp</dimen>
    <dimen name="hero_height">112dp</dimen>
    <dimen name="hero_title">23sp</dimen>
    <dimen name="hero_sub">13sp</dimen>
    <dimen name="section_title">19sp</dimen>
    <dimen name="card_height">82dp</dimen>
    <dimen name="card_logo_size">42dp</dimen>
    <dimen name="card_padding">5dp</dimen>
    <dimen name="card_padding_h">8dp</dimen>
    <dimen name="card_name">15sp</dimen>
    <dimen name="card_name_min">10sp</dimen>
    <dimen name="card_name_gap">5dp</dimen>
    <dimen name="card_badge">11sp</dimen>
    <dimen name="card_meta">12sp</dimen>
    <dimen name="chip_height">36dp</dimen>
    <dimen name="chip_text">14sp</dimen>
    <dimen name="card_radius">11dp</dimen>
    <dimen name="stats_text">15sp</dimen>
    <dimen name="epg_next_text">12sp</dimen>
    <dimen name="hero_logo">64dp</dimen>
    <dimen name="brand_name_text">24sp</dimen>
    <dimen name="top_button_text">17sp</dimen>

    <dimen name="header_gap">4dp</dimen>
    <dimen name="hero_gap">10dp</dimen>
    <dimen name="section_gap">8dp</dimen>
    <dimen name="chips_gap">8dp</dimen>
    <dimen name="card_margin">4dp</dimen>
    <dimen name="hero_title_gap">5dp</dimen>
    <dimen name="hero_sub_gap">2dp</dimen>
    <dimen name="hero_epg_gap">6dp</dimen>
    <dimen name="hero_next_gap">1dp</dimen>

    <!-- 三个次级入口：遥控器上更好找、更好点 -->
    <dimen name="top_button_height">40dp</dimen>
    <dimen name="top_button_padding">22dp</dimen>
    <dimen name="top_button_gap">10dp</dimen>

    <dimen name="tab_width">100dp</dimen>
