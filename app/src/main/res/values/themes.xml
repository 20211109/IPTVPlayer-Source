<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        固定浅色主题（不跟随系统 DayNight）。
        跟随系统时，深色模式会把系统级 AlertDialog 变黑底，
        而本应用文字是深色，弹窗内容会几乎看不见。
    -->
    <style name="Theme.IPTVPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>

        <!-- 所有弹窗统一走浅色玻璃样式 -->
        <item name="alertDialogTheme">@style/Theme.IPTVPlayer.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.IPTVPlayer.Dialog</item>
    </style>

    <!-- 浅色玻璃弹窗：白底 + 大圆角 + 发丝描边 -->
    <style name="Theme.IPTVPlayer.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorAccent">@color/primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowBackground">@drawable/bg_dialog_dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButton</item>
    </style>

    <style name="DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!--
        主按钮：iOS 蓝胶囊 + 白字。
        注意：MaterialButton 会接管 android:background，写 @drawable/bg_brand_button 不会生效
        （弹窗里「保存/添加/完成」会变成没有底色的文字，遥控器移过去也看不到焦点）。
        这里改用 MaterialButton 真正吃的两个属性：backgroundTint 上色、strokeColor 画焦点框。
    -->
    <style name="BrandButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="backgroundTint">@color/brand_button_fill</item>
        <item name="strokeColor">@color/brand_button_stroke</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!-- 次级按钮：白底描边胶囊，聚焦时靠动画放大 -->
    <style name="GhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">@color/border_strong</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!--
        播放页顶部栏专用：同一套胶囊，但文字与描边是白色系。

        不能直接复用 GhostButton —— 它的深灰字是给浅色弹窗用的，
        而顶部栏压在黑色渐变遮罩（bg_top_scrim）上，深灰字放上去等于没写。
        这里只改颜色，尺寸、圆角、聚焦动画都与 GhostButton 保持一致。
    -->
    <style name="PlayerGhostButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">#66FFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!--
        顶部标签：当前页蓝底白字，其余白底深灰字，聚焦蓝描边。
        背景和文字色分别用 selector，遥控器移动时状态才不会错位。
    -->
    <style name="TabButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/tab_text_color</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!-- 我的页整行入口：只负责文字，底板与遥控器焦点框由外层 FrameLayout 的 bg_mine_row 画 -->
    <style name="MineRowButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">none</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:backgroundTint">@null</item>
        <!-- MaterialButton 会接管 android:background 自己画形状，写在按钮上的焦点
             选择器不生效（TV 上光标移过去完全看不见）。这里保持全透明，把描边交给
             外层的 bg_mine_row 画。 -->
        <item name="android:background">@android:color/transparent</item>
        <!-- 整行按钮不能用 focus_scale：1.08 倍会把文字往左推到左侧导航栏下面，
             TV 上看起来就是「设置」第一个字被切掉。焦点反馈交给白描边。 -->
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 底部/侧边导航按钮：选中态由 java 代码换 background -->
    <style name="NavButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!-- 手机底部导航：MaterialButton 默认带 6dp 上下 inset，文字会偏上；清掉并强制居中 -->
    <style name="NavButtonPhone" parent="NavButton">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">2dp</item>
        <item name="iconTint">@color/nav_icon_tint</item>
    </style>

    <!--
        TV 左侧导航按钮。
        注意：这里【不能再写 android:background】—— MaterialButton 会自己画背景，
        写在它身上的 bg_nav_capsule 根本不会被采用，结果就是胶囊形状和白色焦点框
        全丢了，遥控器移过去只剩文字颜色变化，看上去「光标看不清」。
        现在背景（含选中态/焦点态）统一交给外层 NavCapsuleWrap 画。
    -->
    <style name="NavButtonTv" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">@dimen/tv_nav_text</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">@color/nav_icon_tint</item>
        <item name="iconPadding">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:backgroundTint">@null</item>
        <!-- 整块胶囊不做 focus_scale：放大后被父容器裁掉一圈，焦点框反而更糊 -->
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- 左侧导航胶囊外壳：负责胶囊形状 + 选中态 + 白色焦点描边 -->
    <style name="NavCapsuleWrap">
        <item name="android:layout_width">@dimen/tv_nav_capsule_w</item>
        <item name="android:layout_height">@dimen/tv_nav_capsule_h</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:addStatesFromChildren">true</item>
        <item name="android:background">@drawable/bg_nav_capsule</item>
        <item name="android:clipChildren">false</item>
    </style>

    <!-- 分组标签 -->
    <style name="GroupChip" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!-- 设置弹窗行 -->
    <style name="SettingRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="SettingLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 输入框：白底 + 蓝色数值 -->
    <style name="SettingInput">
        <item name="android:layout_width">96dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:backgroundTint">@color/brand_cyan</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:inputType">number</item>
        <item name="android:singleLine">true</item>
    </style>

    <!--
        数值格：电视上用 EditText 改数字要先把光标挪到正确位置、再一位一位按方向键，非常难用；
        改成「胶囊形状的数值 + 按确定弹出数字键盘」，一次改完再确认。
    -->
    <style name="SettingValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">104dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">@drawable/bg_setting_value</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>

    <!--
        只读数值：给「本次已刷新次数 / 上次刷新结果」这类纯展示用。
        不能套 SettingValue —— 那个是可点胶囊（focusable + 焦点放大动画），
        遥控器会停在上面还放大，按确定却没有任何反应，盒子上看着像卡死。
        这里不可聚焦、无背景、与左侧标签同字号，行高由标签决定，垂直居中不会错位。
    -->
    <style name="SettingValueReadonly">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:focusable">false</item>
        <item name="android:focusableInTouchMode">false</item>
        <item name="android:clickable">false</item>
        <item name="android:longClickable">false</item>
    </style>

    <!-- 数字键盘：用 TextView 而不是 Button（MaterialButton 会接管 background，吃掉自定义样式） -->
    <style name="NumKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_num_key</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:stateListAnimator">@animator/focus_scale</item>
    </style>
</resources>
