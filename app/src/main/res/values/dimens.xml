<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 默认（手机）尺寸：更克制的留白与更清晰的字号层级 -->
    <dimen name="page_padding">18dp</dimen>
    <dimen name="page_padding_top">18dp</dimen>
    <dimen name="hero_height">136dp</dimen>
    <dimen name="hero_title">21sp</dimen>
    <dimen name="hero_sub">12sp</dimen>
    <dimen name="section_title">18sp</dimen>
    <dimen name="card_height">104dp</dimen>
    <dimen name="card_logo_size">44dp</dimen>
    <dimen name="card_padding">8dp</dimen>
    <dimen name="card_padding_h">8dp</dimen>
    <!-- 名称：autosize 在 [card_name_min, card_name] 之间自动挑字号，长名不被截断 -->
    <dimen name="card_name">15sp</dimen>
    <dimen name="card_name_min">9sp</dimen>
    <dimen name="card_name_gap">5dp</dimen>
    <dimen name="card_badge">9sp</dimen>
    <dimen name="card_meta">12sp</dimen>
    <dimen name="chip_height">38dp</dimen>
    <dimen name="chip_text">13sp</dimen>
    <dimen name="card_radius">20dp</dimen>
    <dimen name="stats_text">11sp</dimen>
    <dimen name="epg_next_text">11sp</dimen>
    <dimen name="hero_logo">68dp</dimen>
    <dimen name="brand_name_text">26sp</dimen>
    <dimen name="top_button_text">14sp</dimen>

    <!-- 纵向节奏：抽成 dimen 后，各屏幕尺寸可独立压缩，
         保证「频道网格至少露出三行」而不用改布局结构 -->
    <dimen name="header_gap">4dp</dimen>
    <dimen name="hero_gap">16dp</dimen>
    <dimen name="section_gap">12dp</dimen>
    <dimen name="chips_gap">12dp</dimen>
    <dimen name="card_margin">6dp</dimen>
    <dimen name="hero_title_gap">8dp</dimen>
    <dimen name="hero_sub_gap">4dp</dimen>
    <dimen name="hero_epg_gap">10dp</dimen>
    <dimen name="hero_next_gap">3dp</dimen>

    <!-- 直播源 / 关于 / 设置 三个次级入口：
         手机屏宽只有 360dp 左右，放三个按钮必须收紧内边距，
         否则「设置」会被挤出屏幕（大屏版本另有一套更宽松的尺寸） -->
    <dimen name="top_button_height">40dp</dimen>
    <dimen name="top_button_padding">8dp</dimen>
    <dimen name="top_button_gap">6dp</dimen>

    <!-- 顶部四个栏目胶囊：等宽等高、靠左、下移后紧挨焦点卡上方。
         手机四连排 4*72+3*6=306dp < 324dp 可用宽。
         tabs_margin_top 与 header_gap 此消彼长，焦点卡位置保持不变。 -->
    <dimen name="tab_width">72dp</dimen>
    <dimen name="tab_height">40dp</dimen>
    <dimen name="tab_gap">6dp</dimen>
    <dimen name="tabs_margin_top">20dp</dimen>
</resources>
