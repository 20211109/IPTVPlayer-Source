<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 画面比例：labels 用于展示，values 与 PlaybackSettings.zoomMode 一一对应 -->
    <string-array name="zoom_mode_labels">
        <item>适应屏幕（完整画面，可能留黑边）</item>
        <item>裁切铺满（填满屏幕，边缘被裁）</item>
        <item>拉伸铺满（填满屏幕，可能变形）</item>
        <item>自定义缩放（按百分比）</item>
    </string-array>
    <string-array name="zoom_mode_values">
        <item>fit</item>
        <item>crop</item>
        <item>stretch</item>
        <item>scale</item>
    </string-array>

    <string-array name="decoder_labels">
        <item>自动（推荐）</item>
        <item>硬解优先（省 CPU）</item>
        <item>软解优先（兼容花屏/卡死）</item>
    </string-array>
    <string-array name="decoder_values">
        <item>auto</item>
        <item>hardware</item>
        <item>software</item>
    </string-array>

    <string-array name="render_labels">
        <item>SurfaceView（推荐，省电）</item>
        <item>TextureView（兼容模式）</item>
    </string-array>
    <string-array name="render_values">
        <item>surface</item>
        <item>texture</item>
    </string-array>

    <!-- 去黑边档位：0 自动 / 1 一律裁切 / 2 保留原比例 / 3 一律拉伸
         顺序与 PlaybackSettings.autoCropStrength 一致；档位只决定「怎么摆画面」，
         具体判断在 MainActivity.decideCrop()，主内核与软解内核共用同一套规则。 -->
    <string-array name="auto_crop_strength_labels">
        <item>自动（推荐：按设备自动选）</item>
        <item>一律裁切铺满（会裁掉边缘）</item>
        <item>保留原比例（宁可留黑边）</item>
        <item>一律拉伸铺满（画面变宽）</item>
    </string-array>
</resources>
