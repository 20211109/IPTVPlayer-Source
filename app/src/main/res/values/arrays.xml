<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 画面比例：labels 用于展示，values 与 PlaybackSettings.zoomMode 一一对应 -->
    <string-array name="zoom_mode_labels">
        <item>适应屏幕（完整画面，可能留黑边）</item>
        <item>裁切铺满（填满屏幕，边缘被裁）</item>
        <item>拉伸铺满（填满屏幕，可能变形）</item>
        <item>自定义缩放（按百分比）</item>
    </string-array>
    <string-array name="zoom_mode_values">
        <item>fit</item>
        <item>crop</item>
        <item>stretch</item>
        <item>scale</item>
    </string-array>

    <string-array name="decoder_labels">
        <item>自动（推荐）</item>
        <item>硬解优先（省 CPU）</item>
        <item>软解优先（兼容花屏/卡死）</item>
    </string-array>
    <string-array name="decoder_values">
        <item>auto</item>
        <item>hardware</item>
        <item>software</item>
    </string-array>

    <string-array name="render_labels">
        <item>SurfaceView（推荐，省电）</item>
        <item>TextureView（兼容模式）</item>
    </string-array>
    <string-array name="render_values">
        <item>surface</item>
        <item>texture</item>
    </string-array>

    <!-- 去黑边档位：0 自动 / 1 一律裁切 / 2 保留原比例 / 3 一律拉伸
         顺序与 PlaybackSettings.autoCropStrength 一致；档位只决定「怎么摆画面」，
         具体判断在 MainActivity.decideCrop()，主内核与软解内核共用同一套规则。 -->
    <string-array name="auto_crop_strength_labels">
        <item>自动（推荐：按设备自动选）</item>
        <item>一律裁切铺满（会裁掉边缘）</item>
        <item>保留原比例（宁可留黑边）</item>
        <item>一律拉伸铺满（画面变宽）</item>
    </string-array>

    <!-- 订阅源定时刷新档位：0/1/2/3/4 → 关闭/10/20/30/60 分钟。
         代码用 Spinner 位置乘换算得到分钟数，故不需要 values 数组。
         只刷新已勾选启用的源；下载失败或解析不到频道时保留本地缓存。默认关闭。 -->
    <string-array name="source_refresh_labels">
        <item>关闭（不自动刷新）</item>
        <item>每 10 分钟</item>
        <item>每 20 分钟</item>
        <item>每 30 分钟</item>
        <item>每 60 分钟</item>
    </string-array>

    <!-- 界面布局档位：0=自动 / 1=手机 / 2=电视，顺序与 UiLayoutPrefs 的 MODE_* 一致。
         代码用 Spinner 位置直接映射 MODE_AUTO / MODE_PHONE / MODE_TV。 -->
    <string-array name="layout_mode_labels">
        <item>@string/layout_switch_auto</item>
        <item>@string/layout_switch_phone</item>
        <item>@string/layout_switch_tv</item>
    </string-array>
</resources>
