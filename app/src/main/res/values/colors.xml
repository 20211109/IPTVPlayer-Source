<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        中性石墨基调（第二版：明显提亮）。
        最早是近黑 #08090B，在大屏上亮暗反差太硬、久看累眼；先抬到 #171A20 仍偏暗，
        这一版整体进到「深灰蓝」区间：
          页面 #2B313A / 卡片 #3A4250 / 焦点 #525D6E
        仍然是深色 UI（不是浅色主题），但和视频画面的反差已经柔和很多，
        在暗环境里看久了不发胀。文字同步提亮一档，保证在更亮的底色上仍有足够对比。
    -->
    <color name="black">#FF000000</color>
    <color name="background">#FF2B313A</color>
    <color name="background_2">#FF313842</color>
    <color name="surface">#FF3A4250</color>
    <color name="surface_2">#FF46505F</color>
    <color name="card">#FF3A4250</color>
    <color name="card_focus">#FF525D6E</color>

    <!-- 单一强调色：柔和的 iOS 蓝，仅用于焦点、选中和可点击元素 -->
    <color name="brand_cyan">#FF0A84FF</color>
    <color name="brand_blue">#FF0A84FF</color>
    <color name="brand_purple">#FF3F444F</color>
    <color name="primary">#FF5AA9FF</color>
    <color name="primary_dark">#FF0A84FF</color>
    <color name="accent">#FF8CC4FF</color>

    <!-- 文本：三级灰度。最亮一档略降，避免纯白在大屏上「扎眼」 -->
    <color name="text_primary">#FFF0F1F4</color>
    <color name="text_secondary">#FFB9BDC6</color>
    <color name="text_hint">#FF90959E</color>

    <!-- 状态色沿用 iOS 系统色 -->
    <color name="green">#FF32D74B</color>
    <color name="yellow">#FFFFD60A</color>
    <color name="red">#FFFF6B5E</color>

    <!-- 分隔线与遮罩 -->
    <color name="scrim">#CC000000</color>
    <color name="divider">#1FFFFFFF</color>
    <color name="border">#24FFFFFF</color>
    <color name="border_strong">#3DFFFFFF</color>
</resources>
