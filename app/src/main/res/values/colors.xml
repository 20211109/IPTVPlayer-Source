<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        浅色「云端白」方案（Apple 设置页观感）。
        搭配原则：浅灰底 + 白卡 + 深一档焦点 + 单一蓝色强调，不做多色混搭。
        文字用深灰 #1C1C1E 而非纯黑，白底上不扎眼。
    -->
    <color name="black">#FF000000</color>
    <color name="background">#FFF2F2F7</color>
    <color name="background_2">#FFFFFFFF</color>

    <!-- 表面：白卡 + 浅灰焦点 -->
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_2">#FFF2F2F7</color>
    <color name="card">#FFFFFFFF</color>
    <color name="card_focus">#FFE5E5EA</color>

    <!-- 强调色：iOS 蓝，只用于焦点、可点元素和数值 -->
    <color name="brand_cyan">#FF007AFF</color>
    <color name="brand_blue">#FF007AFF</color>
    <color name="brand_purple">#FF8E8E93</color>
    <color name="primary">#FF007AFF</color>
    <color name="primary_dark">#FF0062CC</color>
    <color name="accent">#FF007AFF</color>

    <!-- 文字：深灰三级 -->
    <color name="text_primary">#FF1C1C1E</color>
    <color name="text_secondary">#FF6E6E73</color>
    <color name="text_hint">#FF8E8E93</color>

    <!-- 状态色：iOS 系统色 -->
    <color name="green">#FF34C759</color>
    <color name="yellow">#FFFFCC00</color>
    <color name="red">#FFFF3B30</color>

    <!-- 分隔线与描边：浅色主题用半透明黑 -->
    <color name="scrim">#CC000000</color>
    <color name="divider">#1A000000</color>
    <color name="border">#1A000000</color>
    <color name="border_strong">#4D000000</color>
</resources>
